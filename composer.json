{
    "name": "oscurlo/component-renderer",
    "description": "Lightweight PHP library for rendering reusable HTML components — inspired by JSX, built on DOMDocument, no build step required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "components",
        "html",
        "template",
        "renderer",
        "jsx",
        "dom"
    ],
    "autoload": {
        "psr-4": {
            "Oscurlo\\ComponentRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oscurlo\\ComponentRenderer\\Examples\\": "examples/",
            "Oscurlo\\ComponentRenderer\\Tests\\": "tests/"
        },
        "files": [
            "examples/components/Functions.php"
        ]
    },
    "authors": [
        {
            "name": "Esteban Serna Palacios",
            "email": "esteban.serna.p@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature"
    }
}
